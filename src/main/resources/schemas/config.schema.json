{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/IlyaAndreev05/event-sound-studio/schemas/config.schema.json",
  "title": "Event Sound Studio configuration",
  "type": "object",
  "required": ["schema_version", "app", "active_profile", "settings", "sounds", "event_types", "groups", "bindings", "combos", "profiles", "api"],
  "properties": {
    "schema_version": {"const": 4}, "app": {"const": "event-sound-studio"}, "active_profile": {"type": "string"}, "graph_routes": {"type": "array", "items": {"type": "object"}}, "route_groups": {"type": "array", "items": {"type": "object"}}, "saved_copies": {"type": "array", "items": {"type": "object"}}, "source_profiles": {"type": "object", "properties": {"keyboard": {"type": "string"}, "mouse": {"type": "string"}, "system": {"type": "string"}}, "additionalProperties": false},
    "settings": {"$ref": "#/$defs/settings"}, "sounds": {"type": "array", "items": {"$ref": "#/$defs/sound"}},
    "event_types": {"type": "array", "items": {"$ref": "#/$defs/event"}}, "groups": {"type": "array", "items": {"$ref": "#/$defs/group"}},
    "bindings": {"type": "array", "items": {"$ref": "#/$defs/binding"}}, "combos": {"type": "array", "items": {"$ref": "#/$defs/combo"}},
    "profiles": {"type": "array", "items": {"$ref": "#/$defs/profile"}}, "api": {"type": "object", "properties": {"enabled": {"type": "boolean"}}, "additionalProperties": true}
  },
  "$defs": {
    "volume": {"type": "number", "minimum": 0, "maximum": 1},
    "settings": {"type": "object", "required": ["language", "theme", "master_volume", "master_mute", "output", "preview_output", "input", "wheel"], "properties": {"language": {"enum": ["ru", "en"]}, "theme": {"enum": ["light", "dark", "system"]}, "master_volume": {"$ref": "#/$defs/volume"}, "master_mute": {"type": "boolean"}, "output": {"const": "audio_matrix_events"}, "preview_output": {"allOf": [{"type": "string", "minLength": 1}, {"not": {"const": "audio_matrix_events"}}]}, "mouse_click_policy": {"type": "object", "required": ["mode", "double_click_window_ms"], "properties": {"mode": {"enum": ["immediate_plus_double", "wait_and_suppress"]}, "double_click_window_ms": {"type": "integer", "minimum": 50, "maximum": 1500}}, "additionalProperties": false}, "keyboard_repeat": {"type": "object", "required": ["mode", "minimum_interval_ms"], "properties": {"mode": {"enum": ["ignore", "throttle"]}, "minimum_interval_ms": {"type": "integer", "minimum": 50, "maximum": 5000}}, "additionalProperties": false}, "input": {"type": "object", "properties": {"enable_keyboard": {"type": "boolean"}, "enable_mouse": {"type": "boolean"}, "enable_gnome": {"type": "boolean"}, "deduplicate_alt_tab_focus": {"type": "boolean"}, "device_allowlist": {"type": "array", "items": {"type": "string"}}, "log_key_sequences": {"const": false}}, "additionalProperties": false}, "wheel": {"type": "object", "properties": {"units_per_detent": {"type": "number", "exclusiveMinimum": 0, "maximum": 10000}, "high_resolution_preferred": {"type": "boolean"}, "legacy_deduplication": {"type": "boolean"}}, "additionalProperties": true}}, "additionalProperties": true},
    "sound": {"type": "object", "required": ["id", "name", "path", "format", "volume", "tags"], "properties": {"id": {"type": "string"}, "name": {"type": "string"}, "path": {"type": "string"}, "original_path": {"type": "string"}, "format": {"const": "pcm_wav"}, "volume": {"$ref": "#/$defs/volume"}, "tags": {"type": "array", "items": {"type": "string"}}, "description": {"type": "string"}, "group": {"type": "string"}, "copy_of": {"type": "string"}, "fragment_of": {"type": "string"}, "fragment_start_frame": {"type": "integer", "minimum": 0}, "fragment_end_frame": {"type": "integer", "minimum": 1}, "favorite": {"type": "boolean"}}, "additionalProperties": true},
    "event": {"type": "object", "required": ["id", "source", "match"], "properties": {"id": {"type": "string"}, "name": {"type": "string", "minLength": 1}, "source": {"type": "string"}, "match": {"type": "object"}}, "additionalProperties": true},
    "group": {"type": "object", "required": ["id", "name", "protected", "members", "default_sound"], "properties": {"id": {"type": "string"}, "name": {"type": "string"}, "protected": {"type": "boolean"}, "members": {"type": "array", "items": {"type": "string"}}, "default_sound": {"type": "string"}}, "additionalProperties": true},
    "binding": {"type": "object", "required": ["id", "event", "sound", "enabled", "priority", "volume", "cooldown_ms", "overlap"], "properties": {"id": {"type": "string"}, "name": {"type": "string", "minLength": 1}, "event": {"type": "string"}, "sound": {"type": "string"}, "enabled": {"type": "boolean"}, "priority": {"type": "integer", "minimum": 0, "maximum": 1000}, "volume": {"$ref": "#/$defs/volume"}, "pan": {"type": "number", "minimum": -1, "maximum": 1}, "delay_ms": {"type": "integer", "minimum": 0, "maximum": 5000}, "repeat": {"type": "integer", "minimum": 1, "maximum": 20}, "cooldown_ms": {"type": "integer", "minimum": 0, "maximum": 60000}, "overlap": {"enum": ["mix", "restart", "ignore", "queue"]}, "output": {"const": "profile_default"}, "duration_ms": {"type": "integer", "minimum": 0, "maximum": 30000}, "attack_ms": {"type": "integer", "minimum": 0, "maximum": 5000}, "release_ms": {"type": "integer", "minimum": 0, "maximum": 5000}, "remove_dc": {"type": "boolean"}, "eq": {"$ref": "#/$defs/eq"}}, "additionalProperties": true},
    "eq": {"type": "object", "required": ["enabled", "filters"], "properties": {"enabled": {"type": "boolean"}, "filters": {"type": "array", "maxItems": 12, "items": {"$ref": "#/$defs/eqFilter"}}}, "additionalProperties": false},
    "eqFilter": {"type": "object", "required": ["type", "frequency_hz", "gain_db", "q"], "properties": {"type": {"enum": ["peaking", "notch", "low_shelf", "high_shelf", "high_pass", "low_pass", "band_pass"]}, "frequency_hz": {"type": "number", "minimum": 20, "maximum": 20000}, "gain_db": {"type": "number", "minimum": -24, "maximum": 12}, "q": {"type": "number", "minimum": 0.1, "maximum": 12}}, "additionalProperties": false},
    "combo": {"type": "object", "required": ["id", "keys", "policy"], "properties": {"id": {"type": "string"}, "keys": {"type": "array", "minItems": 2, "maxItems": 4, "items": {"type": "string"}}, "policy": {"enum": ["ONLY_COMBO", "COMBO_AND_KEYS", "SUPPRESS_MODIFIERS"]}}, "additionalProperties": true},
    "profile": {"type": "object", "required": ["id", "name", "enabled_bindings", "output", "master_volume"], "properties": {"id": {"type": "string"}, "name": {"type": "string"}, "enabled_bindings": {"type": "array", "items": {"type": "string"}}, "output": {"const": "audio_matrix_events"}, "master_volume": {"$ref": "#/$defs/volume"}}, "additionalProperties": true}
  },
  "additionalProperties": false
}
